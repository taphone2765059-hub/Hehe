-- ========== ESP ==========
local function สร้างESP(player)
    local บิล = {}

    local ชื่อ = Drawing.new("Text")
    ชื่อ.Size = 14
    ชื่อ.Center = true
    ชื่อ.Outline = true
    ชื่อ.Visible = false
    บิล.ชื่อ = ชื่อ

    local กล่อง = Drawing.new("Square")
    กล่อง.Thickness = 2
    กล่อง.Filled = false
    กล่อง.Visible = false
    บิล.กล่อง = กล่อง

    local เส้น = Drawing.new("Line")
    เส้น.Thickness = 1
    เส้น.Visible = false
    บิล.เส้น = เส้น

    return บิล
end

local function ลบESP(บิล)
    for _, v in pairs(บิล) do
        v:Remove()
    end
end

local function getRole(player)
    local char = player.Character
    if not char then return "ตาย" end
    local function checkTools(container)
        if not container then return nil end
        for _, item in ipairs(container:GetChildren()) do
            local name = item.Name:lower()
            if name:find("knife") or name:find("kunai") then return "Murderer" end
            if name:find("gun") or name:find("sheriff") then return "Sheriff" end
        end
        return nil
    end
    return checkTools(char) or checkTools(player:FindFirstChild("Backpack")) or "Innocent"
end

local สีRole = {
    Murderer = Color3.fromRGB(255, 50, 50),
    Sheriff = Color3.fromRGB(50, 150, 255),
    Innocent = Color3.fromRGB(200, 200, 200),
    ตาย = Color3.fromRGB(80, 80, 80),
}

local ESPList = {}

local function updateESP()
    for player, บิล in pairs(ESPList) do
        if not player or not player.Parent then
            ลบESP(บิล)
            ESPList[player] = nil
            continue
        end

        local char = player.Character
        if not char or player == localPlayer then
            บิล.ชื่อ.Visible = false
            บิล.กล่อง.Visible = false
            บิล.เส้น.Visible = false
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not hrp or not hum then continue end

        local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
        local role = getRole(player)
        local สี = สีRole[role]

        if onScreen and ตั้งค่า.ESP then
            local scale = 1 / pos.Z * 100
            local w = scale * 2
            local h = scale * 3

            บิล.กล่อง.Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
            บิล.กล่อง.Size = Vector2.new(w, h)
            บิล.กล่อง.Color = สี
            บิล.กล่อง.Visible = true

            บิล.ชื่อ.Position = Vector2.new(pos.X, pos.Y - h/2 - 16)
            บิล.ชื่อ.Text = player.Name .. " [" .. role .. "]"
            บิล.ชื่อ.Color = สี
            บิล.ชื่อ.Visible = true

            local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y)
            บิล.เส้น.From = center
            บิล.เส้น.To = Vector2.new(pos.X, pos.Y)
            บิล.เส้น.Color = สี
            บิล.เส้น.Visible = role == "Murderer"
        else
            บิล.ชื่อ.Visible = false
            บิล.กล่อง.Visible = false
            บิล.เส้น.Visible = false
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= localPlayer then
        ESPList[p] = สร้างESP(p)
    end
end

Players.PlayerAdded:Connect(function(p)
    ESPList[p] = สร้างESP(p)
end)

Players.PlayerRemoving:Connect(function(p)
    if ESPList[p] then
        ลบESP(ESPList[p])
        ESPList[p] = nil
    end
end)

-- ========== ยิงทะลุกำแพง ==========
local mt = getrawmetatable(game)
local old = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if ตั้งค่า.ยิงทะลุ and method == "FireServer" then
        local name = tostring(self.Name):lower()
        if name:find("gun") or name:find("shoot") or name:find("sheriff") then
            -- หา murderer
            local target = nil
            for _, p in ipairs(Players:GetPlayers()) do
                if p == localPlayer then continue end
                if getRole(p) == "Murderer" and p.Character then
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then target = hrp.Position end
                end
            end
            if target and args[1] then
                args[1] = target
            end
        end
    end

    return old(self, table.unpack(args))
end)

setreadonly(mt, true)

